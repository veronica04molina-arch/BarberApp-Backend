# Configurar estos valores en el panel de Render. No guardar secretos en Git.
SPRING_PROFILES_ACTIVE=prod

# Dominio final de Cloudflare Pages, sin barra final.
FRONTEND_URL=https://tu-frontend.pages.dev

# URL pública del servicio Render, sin barra final.
BACKEND_PUBLIC_URL=https://tu-backend.onrender.com

# Secretos: establecer sus valores solo en Render.
DB_URL=
DB_USER=
DB_PASSWORD=
JWT_SECRET=
GOOGLE_CLIENT_ID=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
